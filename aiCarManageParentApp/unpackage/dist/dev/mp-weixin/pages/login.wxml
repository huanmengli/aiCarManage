<view class="login-container data-v-18804380"><view class="title-section data-v-18804380"><text class="main-title data-v-18804380">家长登录</text><text class="sub-title data-v-18804380">欢迎回来，请登录您的账号</text></view><view class="form-section data-v-18804380"><view class="input-item data-v-18804380"><image class="input-icon data-v-18804380" src="/static/phone.png" mode="aspectFit"></image><input class="input-field data-v-18804380" type="number" placeholder="请输入手机号" maxlength="11" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['formData']]]]]}}" value="{{formData.phone}}" bindinput="__e"/></view><view class="input-item data-v-18804380"><image class="input-icon data-v-18804380" src="/static/password.png" mode="aspectFit"></image><input class="input-field data-v-18804380" type="{{pwdType}}" placeholder="请输入密码" data-event-opts="{{[['input',[['__set_model',['$0','password','$event',[]],['formData']]]]]}}" value="{{formData.password}}" bindinput="__e"/><image class="eye-icon data-v-18804380" src="{{pwdType==='password'?'/static/eye_close.png':'/static/eye_open.png'}}" mode="aspectFit" data-event-opts="{{[['tap',[['togglePwd',['$event']]]]]}}" bindtap="__e"></image></view><button data-event-opts="{{[['tap',[['handleLogin',['$event']]]]]}}" class="login-btn data-v-18804380" bindtap="__e">立即登录</button><view class="register-tip data-v-18804380"><text class="data-v-18804380">还没有账号?</text><text data-event-opts="{{[['tap',[['goRegister',['$event']]]]]}}" class="register-link data-v-18804380" bindtap="__e">立即注册</text></view></view></view>