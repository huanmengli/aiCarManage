<view class="page"><view class="top-card"><view><text class="page-title">接送人管理</text><text class="page-desc">维护可接送学生的家长与亲属信息</text></view><button data-event-opts="{{[['tap',[['openForm']]]]}}" class="add-btn" bindtap="__e">新增</button></view><view class="student-card"><view class="student-avatar"><text>{{$root.g0}}</text></view><view><text class="student-name">{{studentInfo.name}}</text><text class="student-class">{{studentInfo.className}}</text></view></view><block wx:for="{{pickupPeople}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="pickup-card"><view class="pickup-head"><view class="pickup-main"><text class="pickup-name">{{item.name}}</text><text class="relation">{{item.relation}}</text><block wx:if="{{item.isDefault}}"><text class="default-tag">默认</text></block></view><text class="{{['state',(!item.enabled)?'disabled':'']}}">{{item.enabled?'启用':'停用'}}</text></view><view class="pickup-info"><view class="info-row"><text class="info-label">手机号</text><text class="info-value">{{item.phone}}</text></view><view class="info-row"><text class="info-label">车辆</text><text class="info-value">{{item.carNo||'未登记车辆'}}</text></view><view class="info-row"><text class="info-label">身份状态</text><text class="info-value">{{item.verified?'已认证':'待认证'}}</text></view></view><view class="actions"><block wx:if="{{!item.isDefault}}"><button data-event-opts="{{[['tap',[['setDefault',['$0'],[[['pickupPeople','id',item.id,'id']]]]]]]}}" class="text-btn" bindtap="__e">设为默认</button></block><button data-event-opts="{{[['tap',[['toggleEnabled',['$0'],[[['pickupPeople','id',item.id,'id']]]]]]]}}" class="text-btn" bindtap="__e">{{item.enabled?'停用':'启用'}}</button><button data-event-opts="{{[['tap',[['openForm',['$0'],[[['pickupPeople','id',item.id]]]]]]]}}" class="text-btn" bindtap="__e">编辑</button><button data-event-opts="{{[['tap',[['removePickup',['$0'],[[['pickupPeople','id',item.id,'id']]]]]]]}}" class="text-btn danger" bindtap="__e">删除</button></view></view></block><block wx:if="{{showForm}}"><view data-event-opts="{{[['tap',[['closeForm',['$event']]]]]}}" class="form-mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="form-panel" catchtap="__e"><view class="form-head"><text class="form-title">{{editingId?'编辑接送人':'新增接送人'}}</text><text data-event-opts="{{[['tap',[['closeForm',['$event']]]]]}}" class="close" bindtap="__e">关闭</text></view><view class="field"><text class="field-label">姓名</text><input class="field-input" placeholder="请输入姓名" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['form']]]]]}}" value="{{form.name}}" bindinput="__e"/></view><view class="field"><text class="field-label">关系</text><input class="field-input" placeholder="如：父亲、母亲、外婆" data-event-opts="{{[['input',[['__set_model',['$0','relation','$event',[]],['form']]]]]}}" value="{{form.relation}}" bindinput="__e"/></view><view class="field"><text class="field-label">手机号</text><input class="field-input" type="number" placeholder="请输入手机号" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['form']]]]]}}" value="{{form.phone}}" bindinput="__e"/></view><view class="field"><text class="field-label">车牌号</text><input class="field-input" placeholder="可选" data-event-opts="{{[['input',[['__set_model',['$0','carNo','$event',[]],['form']]]]]}}" value="{{form.carNo}}" bindinput="__e"/></view><view class="switch-row"><text class="field-label">设为默认接送人</text><switch checked="{{form.isDefault}}" color="#2563eb" data-event-opts="{{[['change',[['onDefaultChange',['$event']]]]]}}" bindchange="__e"></switch></view><button data-event-opts="{{[['tap',[['savePickup',['$event']]]]]}}" class="save-btn" bindtap="__e">保存</button></view></view></block></view>