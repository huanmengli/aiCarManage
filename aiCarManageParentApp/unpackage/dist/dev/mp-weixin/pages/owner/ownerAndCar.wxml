<view class="container"><view class="nav-bar"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="nav-back" bindtap="__e"><text class="icon">←</text></view><text class="nav-title">车辆管理</text><view class="nav-placeholder"></view></view><view class="vehicle-header"><view class="header-info"><text class="vehicle-count">{{"共 "+$root.g0+" 辆车"}}</text><text class="vehicle-limit">最多可添加5辆车</text></view><view class="header-icon"><text class="icon-car">🚗</text></view></view><scroll-view class="vehicle-list" scroll-y="{{true}}"><block wx:for="{{vehicleList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="vehicle-card"><view class="card-left"><view class="car-icon-wrapper"><text class="car-icon">🚙</text></view><view class="car-info"><view class="plate-row"><text class="plate-number">{{item.plate}}</text><block wx:if="{{item.isDefault}}"><text class="default-tag">默认</text></block></view><text class="car-detail">{{item.color+" · "+item.brand}}</text></view></view><view class="card-right"><view data-event-opts="{{[['tap',[['openEdit',['$0',index],[[['vehicleList','',index]]]]]]]}}" class="btn-edit" bindtap="__e"><text class="icon">✏️</text></view><view data-event-opts="{{[['tap',[['deleteVehicle',[index]]]]]}}" class="btn-delete" bindtap="__e"><text class="icon">🗑️</text></view></view></view></block></scroll-view><view class="add-btn-wrapper"><view data-event-opts="{{[['tap',[['openAdd',['$event']]]]]}}" class="add-btn" bindtap="__e"><text class="icon">+</text><text>添加车辆</text></view></view><block wx:if="{{showModal}}"><view data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="modal-mask" bindtap="__e"></view></block><block wx:if="{{showModal}}"><view class="modal-content"><view class="modal-header"><text class="modal-title">{{isEdit?'编辑车辆':'添加车辆'}}</text><view data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="modal-close" bindtap="__e"><text>✕</text></view></view><view class="modal-body"><view class="form-item"><text class="form-label">车牌号</text><input class="form-input" placeholder="请输入车牌号" maxlength="10" data-event-opts="{{[['input',[['__set_model',['$0','plate','$event',[]],['form']]]]]}}" value="{{form.plate}}" bindinput="__e"/></view><view class="form-item"><text class="form-label">车辆颜色</text><view class="color-list"><block wx:for="{{colorList}}" wx:for-item="color" wx:for-index="idx" wx:key="idx"><view data-event-opts="{{[['tap',[['selectColor',['$0'],[[['colorList','',idx]]]]]]]}}" class="{{['color-item',(form.color===color.name)?'active':'']}}" bindtap="__e"><view class="color-circle" style="{{'background-color:'+(color.value)+';'}}"></view></view></block></view></view><view class="form-item"><text class="form-label">品牌型号</text><input class="form-input" placeholder="请输入品牌型号" data-event-opts="{{[['input',[['__set_model',['$0','brand','$event',[]],['form']]]]]}}" value="{{form.brand}}" bindinput="__e"/></view><view class="form-item switch-item"><text class="form-label">设为默认车辆</text><switch checked="{{form.isDefault}}" color="#2563eb" data-event-opts="{{[['change',[['toggleDefault',['$event']]]]]}}" bindchange="__e"></switch></view></view><view class="modal-footer"><view data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="btn-cancel" bindtap="__e">取消</view><view data-event-opts="{{[['tap',[['confirm',['$event']]]]]}}" class="btn-confirm" bindtap="__e">确认</view></view></view></block></view>