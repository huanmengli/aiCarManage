
page {
	background: #f5f7fb;
}
.page {
	min-height: 100vh;
	padding: 3.733vw;
	box-sizing: border-box;
	color: #1f2937;
}
.top-card,
.student-card,
.pickup-card {
	background: #ffffff;
	border-radius: 2.4vw;
	box-shadow: 0 1.867vw 5.067vw rgba(31, 41, 55, 0.07);
}
.top-card {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 4vw 3.733vw;
}
.page-title {
	display: block;
	font-size: 5.333vw;
	font-weight: 800;
	color: #111827;
}
.page-desc {
	display: block;
	margin-top: 1.333vw;
	font-size: 3.333vw;
	color: #6b7280;
}
.add-btn {
	width: 17.6vw;
	height: 9.067vw;
	line-height: 9.067vw;
	margin: 0;
	border-radius: 1.6vw;
	background: #2563eb;
	color: #ffffff;
	font-size: 3.6vw;
}
.student-card {
	display: flex;
	align-items: center;
	margin-top: 2.933vw;
	padding: 3.2vw 3.733vw;
}
.student-avatar {
	width: 10.4vw;
	height: 10.4vw;
	border-radius: 50%;
	background: #0f766e;
	color: #ffffff;
	font-size: 4.533vw;
	font-weight: 700;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 2.4vw;
}
.student-name {
	display: block;
	font-size: 4.133vw;
	font-weight: 700;
}
.student-class {
	display: block;
	margin-top: 0.8vw;
	font-size: 3.2vw;
	color: #6b7280;
}
.pickup-card {
	margin-top: 2.933vw;
	padding: 3.733vw;
}
.pickup-head,
.pickup-main,
.actions,
.info-row,
.form-head,
.switch-row {
	display: flex;
	align-items: center;
}
.pickup-head,
.info-row,
.form-head,
.switch-row {
	justify-content: space-between;
}
.pickup-name {
	font-size: 4.4vw;
	font-weight: 700;
	color: #111827;
}
.relation,
.default-tag {
	margin-left: 1.6vw;
	padding: 0.8vw 1.6vw;
	border-radius: 133.2vw;
	font-size: 2.933vw;
}
.relation {
	background: #eef2ff;
	color: #3730a3;
}
.default-tag {
	background: #fff7ed;
	color: #c2410c;
}
.state {
	font-size: 3.2vw;
	color: #047857;
}
.state.disabled {
	color: #9ca3af;
}
.pickup-info {
	margin-top: 2.667vw;
	padding: 2.133vw 0;
	border-top: 0.133vw solid #eef2f7;
	border-bottom: 0.133vw solid #eef2f7;
}
.info-row {
	min-height: 7.467vw;
}
.info-label {
	color: #6b7280;
	font-size: 3.333vw;
}
.info-value {
	max-width: 56vw;
	text-align: right;
	font-size: 3.467vw;
	color: #111827;
}
.actions {
	justify-content: flex-end;
	gap: 1.867vw;
	margin-top: 2.933vw;
	flex-wrap: wrap;
}
.text-btn {
	height: 7.733vw;
	line-height: 7.733vw;
	margin: 0;
	padding: 0 2.667vw;
	border-radius: 1.333vw;
	background: #f3f4f6;
	color: #374151;
	font-size: 3.2vw;
}
.text-btn.danger {
	background: #fef2f2;
	color: #b91c1c;
}
.form-mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 20;
	background: rgba(17, 24, 39, 0.42);
	display: flex;
	align-items: flex-end;
}
.form-panel {
	width: 100vw;
	padding: 4vw 3.733vw 6.4vw;
	box-sizing: border-box;
	border-radius: 3.733vw 3.733vw 0 0;
	background: #ffffff;
}
.form-title {
	font-size: 4.533vw;
	font-weight: 800;
}
.close {
	font-size: 3.467vw;
	color: #2563eb;
}
.field {
	margin-top: 2.933vw;
}
.field-label {
	font-size: 3.467vw;
	color: #4b5563;
}
.field-input {
	margin-top: 1.6vw;
	height: 10.4vw;
	padding: 0 2.667vw;
	border-radius: 1.6vw;
	background: #f3f4f6;
	font-size: 3.733vw;
}
.switch-row {
	margin-top: 2.933vw;
	min-height: 9.6vw;
}
.save-btn {
	margin-top: 3.467vw;
	height: 11.733vw;
	line-height: 11.733vw;
	border-radius: 1.867vw;
	background: #2563eb;
	color: #ffffff;
	font-size: 4vw;
	font-weight: 700;
}

