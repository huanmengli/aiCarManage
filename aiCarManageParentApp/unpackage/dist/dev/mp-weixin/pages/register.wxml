<view class="register-container data-v-2339929c"><view class="title-section data-v-2339929c"><text class="main-title data-v-2339929c">注册账号</text><text class="sub-title data-v-2339929c">创建一个新账号以开始使用</text></view><view class="form-section data-v-2339929c"><view class="input-item data-v-2339929c"><input class="input-field data-v-2339929c" type="number" placeholder="手机号" maxlength="11" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['formData']]]]]}}" value="{{formData.phone}}" bindinput="__e"/></view><view class="input-item data-v-2339929c"><input class="input-field data-v-2339929c" type="{{pwdType1}}" placeholder="设置密码" data-event-opts="{{[['input',[['__set_model',['$0','password','$event',[]],['formData']]]]]}}" value="{{formData.password}}" bindinput="__e"/><image class="eye-icon data-v-2339929c" src="{{pwdType1==='password'?'/static/eye_close.png':'/static/eye_open.png'}}" mode="aspectFit" data-event-opts="{{[['tap',[['togglePwd1',['$event']]]]]}}" bindtap="__e"></image></view><view class="input-item data-v-2339929c"><input class="input-field data-v-2339929c" type="{{pwdType2}}" placeholder="确认密码" data-event-opts="{{[['input',[['__set_model',['$0','confirmPwd','$event',[]],['formData']]]]]}}" value="{{formData.confirmPwd}}" bindinput="__e"/><image class="eye-icon data-v-2339929c" src="{{pwdType2==='password'?'/static/eye_close.png':'/static/eye_open.png'}}" mode="aspectFit" data-event-opts="{{[['tap',[['togglePwd2',['$event']]]]]}}" bindtap="__e"></image></view><button data-event-opts="{{[['tap',[['handleRegister',['$event']]]]]}}" class="register-btn data-v-2339929c" bindtap="__e">完成注册</button></view></view>