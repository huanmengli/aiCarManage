<view class="index-page data-v-71e217db"><view class="header data-v-71e217db"><view class="date-text data-v-71e217db">{{currentDate}}</view><view class="greeting data-v-71e217db"><text class="greeting-text data-v-71e217db">王老师，工作顺利</text><view data-event-opts="{{[['tap',[['handleAction',['$event']]]]]}}" class="action-btn data-v-71e217db" bindtap="__e"><view class="grid-icon data-v-71e217db"><view class="grid-cell data-v-71e217db"></view><view class="grid-cell data-v-71e217db"></view><view class="grid-cell data-v-71e217db"></view><view class="grid-cell data-v-71e217db"></view></view></view></view></view><view class="stats-container data-v-71e217db"><view class="stat-card data-v-71e217db"><view class="stat-label data-v-71e217db">全部通知</view><view class="stat-value blue data-v-71e217db">{{stats.notified}}</view></view><view class="stat-card data-v-71e217db"><view class="stat-label data-v-71e217db">已收到</view><view class="stat-value green data-v-71e217db">{{stats.received}}</view></view><view class="stat-card data-v-71e217db"><view class="stat-label data-v-71e217db">未收到</view><view class="stat-value orange data-v-71e217db">{{stats.pending}}</view></view></view><view class="progress-section data-v-71e217db"><view class="progress-circle data-v-71e217db"><canvas class="canvas data-v-71e217db" type="2d" id="progressCanvas"></canvas><view class="progress-text data-v-71e217db"><text class="progress-percent data-v-71e217db">{{progress+"%"}}</text><text class="progress-label data-v-71e217db">总体进度</text></view></view><view class="progress-info data-v-71e217db"><view class="progress-title data-v-71e217db">今日接送动态</view><view class="progress-detail data-v-71e217db"><text class="detail-label data-v-71e217db">当前高峰期</text><text class="detail-value data-v-71e217db">{{peakTime}}</text></view><view class="progress-bar data-v-71e217db"><view class="progress-bar-fill data-v-71e217db" style="{{'width:'+(progress+'%')+';'}}"></view></view><view class="progress-tip data-v-71e217db"><text class="data-v-71e217db">{{tip}}</text></view></view></view><view class="notification-section data-v-71e217db"><view class="notification-header data-v-71e217db"><text class="notification-title data-v-71e217db">家长通知动态</text><text data-event-opts="{{[['tap',[['handleSeeAll',['$event']]]]]}}" class="see-all data-v-71e217db" bindtap="__e">查看全部</text></view><view class="notification-list data-v-71e217db"><block wx:for="{{notifications}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="notification-card data-v-71e217db"><view class="avatar data-v-71e217db"><image class="avatar-img data-v-71e217db" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=teacher%20avatar&image_size=square" mode="aspectFill"></image></view><view class="notification-info data-v-71e217db"><text class="student-name data-v-71e217db">{{item.studentName+" "+item.className}}</text><text class="parent-name data-v-71e217db">{{"家长："+item.parentName}}</text></view><view class="{{['data-v-71e217db','status-tag',item.status]}}"><text class="data-v-71e217db">{{item.statusText}}</text></view></view></block></view></view></view>