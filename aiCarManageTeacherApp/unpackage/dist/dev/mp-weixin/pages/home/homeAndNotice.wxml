<view class="container"><view class="nav-bar"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="nav-back" bindtap="__e"><text class="icon">←</text></view><text class="nav-title">家长通知动态</text><view class="nav-placeholder"></view></view><view class="stats-header"><view class="stats-info"><text class="stats-count">{{"共 "+$root.g0+" 位家长"}}</text><text class="stats-detail">{{"已收到 "+receivedCount+" 人 · 未收到 "+unreceivedCount+" 人"}}</text></view><view class="stats-icon"><text class="icon-bell">🔔</text></view></view><view class="filter-tabs"><view data-event-opts="{{[['tap',[['switchTab',['all']]]]]}}" class="{{['tab-item',(currentTab==='all')?'active':'']}}" bindtap="__e">全部<text class="tab-badge">{{$root.g1}}</text></view><view data-event-opts="{{[['tap',[['switchTab',['received']]]]]}}" class="{{['tab-item',(currentTab==='received')?'active':'']}}" bindtap="__e">已收到<text class="tab-badge">{{receivedCount}}</text></view><view data-event-opts="{{[['tap',[['switchTab',['unreceived']]]]]}}" class="{{['tab-item',(currentTab==='unreceived')?'active':'']}}" bindtap="__e">未收到<text class="tab-badge">{{unreceivedCount}}</text></view></view><scroll-view class="notice-list" scroll-y="{{true}}"><block wx:for="{{filteredList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="notice-card"><image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image><view class="notice-info"><view class="info-row"><text class="student-name">{{item.studentName}}</text><text class="class-name">{{item.className}}</text></view><view class="parent-row"><text class="parent-label">家长：</text><text class="parent-name">{{item.parentName}}</text></view></view><view class="status-wrapper"><text class="{{['status-tag',item.status]}}">{{item.statusText}}</text><text class="notice-time">{{item.time}}</text></view></view></block><block wx:if="{{$root.g2===0}}"><view class="empty-state"><text class="empty-icon">📭</text><text class="empty-text">暂无相关通知记录</text></view></block></scroll-view></view>