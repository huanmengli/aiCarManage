<view class="data-page data-v-79cd65ef"><view class="header data-v-79cd65ef"><text class="page-title data-v-79cd65ef">数据统计</text></view><view class="tab-bar data-v-79cd65ef"><block wx:for="{{tabs}}" wx:for-item="tab" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['handleTabChange',['$0'],[[['tabs','id',tab.id,'id']]]]]]]}}" class="{{['data-v-79cd65ef','tab-item',[(currentTab===tab.id)?'active':'']]}}" bindtap="__e"><text class="data-v-79cd65ef">{{tab.name}}</text></view></block></view><view class="content data-v-79cd65ef"><view class="core-stats-section data-v-79cd65ef"><view class="core-stats-card data-v-79cd65ef"><view class="core-stats-row data-v-79cd65ef"><view class="core-stat-item data-v-79cd65ef"><text class="core-stat-label data-v-79cd65ef">平均接送时长</text><view class="core-stat-value data-v-79cd65ef"><text class="value data-v-79cd65ef">{{currentStats.avgDuration}}</text><text class="unit data-v-79cd65ef">min</text></view><view class="{{['core-stat-trend','data-v-79cd65ef',currentStats.avgTrend]}}"><text class="trend-icon data-v-79cd65ef">{{currentStats.avgTrend==='up'?'↗':'↘'}}</text><text class="trend-text data-v-79cd65ef">{{currentStats.avgTrendText}}</text></view></view><view class="core-stat-item data-v-79cd65ef"><text class="core-stat-label data-v-79cd65ef">今日接送车辆</text><view class="core-stat-value data-v-79cd65ef"><text class="value data-v-79cd65ef">{{currentStats.todayVehicles}}</text><text class="unit data-v-79cd65ef">辆</text></view><view class="core-stat-trend stable data-v-79cd65ef"><text class="trend-icon data-v-79cd65ef">↗</text><text class="trend-text data-v-79cd65ef">运行平稳</text></view></view></view></view></view><block wx:if="{{currentTab!=='day'}}"><view class="chart-section data-v-79cd65ef"><view class="chart-card data-v-79cd65ef"><view class="chart-title data-v-79cd65ef"><text class="data-v-79cd65ef">{{currentTab==='week'?'每周接送时间趋势 (MIN)':'每月接送时间趋势 (MIN)'}}</text></view><view class="chart-container data-v-79cd65ef"><canvas class="line-canvas data-v-79cd65ef" type="2d" id="lineChart"></canvas></view></view></view></block><view class="grade-section data-v-79cd65ef"><view class="grade-card data-v-79cd65ef"><view class="grade-title data-v-79cd65ef"><text class="data-v-79cd65ef">各年级平均耗时对比</text></view><view class="grade-list data-v-79cd65ef"><block wx:for="{{gradeData}}" wx:for-item="grade" wx:for-index="__i1__" wx:key="id"><view class="grade-item data-v-79cd65ef"><view class="grade-info data-v-79cd65ef"><view class="grade-dot data-v-79cd65ef" style="{{'background-color:'+(grade.color)+';'}}"></view><text class="grade-name data-v-79cd65ef">{{grade.name}}</text></view><view class="grade-bar-container data-v-79cd65ef"><view class="grade-bar-bg data-v-79cd65ef"></view><view class="grade-bar data-v-79cd65ef" style="{{'width:'+(grade.duration/maxDuration*100+'%')+';'+('background-color:'+(grade.color)+';')}}"></view></view><text class="grade-duration data-v-79cd65ef">{{grade.duration+"m"}}</text></view></block></view></view></view><block wx:if="{{currentTab==='day'}}"><view class="hint-section data-v-79cd65ef"><view class="hint-card data-v-79cd65ef"><view class="hint-icon data-v-79cd65ef">📈</view><view class="hint-text data-v-79cd65ef"><text class="hint-title data-v-79cd65ef">查看更多分析</text><text class="hint-desc data-v-79cd65ef">切换到「本周」或「本月」查看趋势图表</text></view></view></view></block></view></view>