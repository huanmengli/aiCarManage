
.mine-wrap.data-v-97c2b8e6 {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding: 4vw;
  padding-bottom: 16vw;
}

/* 顶部用户卡片 */
.user-card.data-v-97c2b8e6 {
  background: linear-gradient(135deg, #2563eb, #4080ff);
  border-radius: 3.2vw;
  padding: 5.33vw 4vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 1.33vw 4vw rgba(37, 99, 235, 0.25);
  margin-bottom: 2.66vw;
}
.user-left.data-v-97c2b8e6 {
  display: flex;
  align-items: center;
}
.user-avatar.data-v-97c2b8e6 {
  width: 16vw;
  height: 16vw;
  border-radius: 50%;
  border: 0.4vw solid #ffffff;
}
.user-info.data-v-97c2b8e6 {
  margin-left: 3.33vw;
}
.user-name.data-v-97c2b8e6 {
  font-size: 5.06vw;
  color: #fff;
  font-weight: 500;
  display: block;
}
.user-phone.data-v-97c2b8e6 {
  font-size: 3.46vw;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 1.06vw;
}
.arrow-right.data-v-97c2b8e6 {
  display: flex;
  align-items: center;
}
.edit-txt.data-v-97c2b8e6 {
  font-size: 3.46vw;
  color: #fff;
  margin-right: 1.06vw;
}
.right-icon.data-v-97c2b8e6 {
  width: 2.13vw;
  height: 3.73vw;
}

/* 统计卡片（可点击） */
.stat-card.data-v-97c2b8e6 {
  background: #fff;
  border-radius: 2.66vw;
  display: flex;
  padding: 4vw 0;
  margin-bottom: 4vw;
  box-shadow: 0 0.53vw 1.6vw rgba(0, 0, 0, 0.04);
}
.stat-item.data-v-97c2b8e6 {
  flex: 1;
  text-align: center;
}
.stat-num.data-v-97c2b8e6 {
  font-size: 5.6vw;
  font-weight: bold;
  color: #2563eb;
  line-height: 1.2;
}
.stat-label.data-v-97c2b8e6 {
  font-size: 3.46vw;
  color: #666;
}
.stat-line.data-v-97c2b8e6 {
  width: 0.13vw;
  height: 6.66vw;
  background: #eee;
  align-self: center;
}

/* 功能列表 */
.func-box.data-v-97c2b8e6 {
  background-color: #ffffff;
  border-radius: 2.66vw;
  overflow: hidden;
}
.func-item.data-v-97c2b8e6 {
  display: flex;
  align-items: center;
  padding: 4.66vw 4vw;
  border-bottom: 0.13vw solid #f2f3f5;
}
.func-item.data-v-97c2b8e6:last-child {
  border-bottom: none;
}
.func-icon.data-v-97c2b8e6 {
  width: 10.13vw;
  height: 10.13vw;
  border-radius: 2.4vw;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bg-blue.data-v-97c2b8e6 { background-color: #e8f1ff;
}
.bg-orange.data-v-97c2b8e6 { background-color: #fff3e8;
}
.bg-green.data-v-97c2b8e6 { background-color: #e8faf0;
}
.icon-img.data-v-97c2b8e6 { width: 5.33vw; height: 5.33vw;
}
.func-name.data-v-97c2b8e6 {
  flex: 1;
  font-size: 4.26vw;
  color: #333;
  margin-left: 2.93vw;
}
.item-arrow.data-v-97c2b8e6 { width: 2.13vw; height: 3.73vw;
}

/* 底部固定退出按钮 */
.logout-btn.data-v-97c2b8e6 {
  position: fixed;
  bottom: 5.33vw;
  left: 4vw;
  right: 4vw;
  background-color: #fff;
  text-align: center;
  line-height: 12vw;
  border-radius: 2.4vw;
  font-size: 4.26vw;
  color: #f53f3f;
  box-shadow: 0 0.53vw 2vw rgba(245, 63, 63, 0.15);
}

