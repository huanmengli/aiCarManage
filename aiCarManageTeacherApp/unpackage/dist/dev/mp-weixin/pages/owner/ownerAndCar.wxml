<view class="container"><view class="search-bar"><view class="search-box"><text class="icon-search">🔍</text><input type="text" placeholder="搜索学校或地点" data-event-opts="{{[['input',[['__set_model',['','searchValue','$event',[]]]]]]}}" value="{{searchValue}}" bindinput="__e"/></view></view><view class="map-wrapper"><map class="school-map" id="schoolMap" longitude="{{school.longitude}}" latitude="{{school.latitude}}" scale="{{scale}}" markers="{{markers}}" polyline="{{polyline}}" show-location="{{true}}"></map><cover-view class="school-label-wrapper"><cover-view class="school-label">学校</cover-view><cover-view class="school-label-arrow"></cover-view></cover-view></view><scroll-view class="routes-section" scroll-y="{{true}}"><view class="section-title">推荐接送路线</view><block wx:for="{{routes}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectRoute',[index]]]]]}}" class="{{['route-card',(currentRoute===index)?'active':'']}}" bindtap="__e"><view class="route-header"><view class="route-name"><view class="{{['route-dot',item.statusClass]}}"></view><text>{{item.name}}</text></view><view class="{{['route-status',item.statusClass]}}">{{item.statusText}}</view></view><view class="route-info"><view class="info-item"><text class="icon">⏱</text><text>{{item.time+" 分钟"}}</text></view><view class="info-item"><text class="icon">📍</text><text>{{item.distance+" km"}}</text></view></view><block wx:if="{{item.recommend}}"><view class="recommend-tag">推荐</view></block></view></block></scroll-view></view>