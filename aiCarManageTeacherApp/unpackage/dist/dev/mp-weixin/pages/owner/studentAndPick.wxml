<view class="page"><view class="student-panel"><view class="student-left"><view class="avatar"><text>{{$root.g0}}</text></view><view class="student-text"><text class="student-name">{{studentInfo.name}}</text><text class="student-desc">{{studentInfo.gradeName+" · "+studentInfo.className}}</text></view></view><view class="count-box"><text class="count-num">{{enabledCount}}</text><text class="count-label">可接送</text></view></view><view class="notice-card"><text class="notice-title">接送人核对</text><text class="notice-desc">教师端用于查看该学生所有已绑定接送人，便于放学接送时核验身份。</text></view><block wx:if="{{$root.g1}}"><view class="pickup-list"><block wx:for="{{pickupPeople}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="pickup-card"><view class="card-head"><view class="person-main"><text class="person-name">{{item.name}}</text><text class="relation">{{item.relation}}</text><block wx:if="{{item.isDefault}}"><text class="default-tag">默认</text></block></view><text class="{{['state',(!item.enabled)?'disabled':'']}}">{{item.enabled?'允许接送':'已停用'}}</text></view><view class="detail-grid"><view class="detail-row"><text class="detail-label">手机号</text><text class="detail-value">{{item.phone}}</text></view><view class="detail-row"><text class="detail-label">车牌号</text><text class="detail-value">{{item.carNo||'未登记车辆'}}</text></view><view class="detail-row"><text class="detail-label">认证状态</text><text class="detail-value">{{item.verified?'已认证':'待认证'}}</text></view><view class="detail-row"><text class="detail-label">最近接送</text><text class="detail-value">{{item.lastPickupTime||'暂无记录'}}</text></view></view><view class="action-row"><button data-event-opts="{{[['tap',[['callPhone',['$0'],[[['pickupPeople','id',item.id,'phone']]]]]]]}}" class="action-btn" bindtap="__e">联系</button><button data-event-opts="{{[['tap',[['showPickupDetail',['$0'],[[['pickupPeople','id',item.id]]]]]]]}}" class="action-btn ghost" bindtap="__e">查看详情</button></view></view></block></view></block><block wx:else><view class="empty"><text class="empty-title">暂无接送人</text><text class="empty-desc">该学生还没有绑定家长或接送人</text></view></block></view>